# Copier vers .env puis adapter. Aucun secret dans le dépôt.
POSTGRES_USER=ilo
POSTGRES_PASSWORD=change-me-db
POSTGRES_DB=ilo

# Authentification simple (mot de passe unique). AUTH_ENABLED=false pour l'usage local sans mot de passe.
AUTH_ENABLED=true
APP_PASSWORD=change-me
SECRET_KEY=change-me-long-random-string

# Ports exposés
WEB_PORT=8080
API_PORT=8000

# Style de carte MapLibre (OpenFreeMap : gratuit, sans clé). Remplaçable par n'importe quel style.
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Alertes e-mail (optionnel ; sinon fichier data/alerts.log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
